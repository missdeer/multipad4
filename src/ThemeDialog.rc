#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_THEME_CONFIG DIALOGEX 0, 0, 500, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Language Style Configurator"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Select theme:", -1, 14, 14, 58, 12
    COMBOBOX IDC_THEME_LIST, 76, 10, 262, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Import...", IDC_THEME_IMPORT, 346, 10, 66, 12
    PUSHBUTTON "Theme...", IDC_THEME_ACTIONS, 420, 10, 66, 12
    GROUPBOX "", -1, 10, 34, 150, 204
    LTEXT "Language:", -1, 20, 46, 130, 12
    COMBOBOX IDC_THEME_LANGUAGE, 20, 60, 130, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Style:", -1, 20, 85, 130, 12
    LISTBOX IDC_THEME_STYLES, 20, 99, 130, 116, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Detailed styles", IDC_THEME_DETAILS, 20, 224, 130, 12
    GROUPBOX "", -1, 170, 34, 320, 204
    LTEXT "", IDC_THEME_STYLE_INFO, 182, 46, 296, 18
    GROUPBOX "Colour style", IDC_THEME_COLOUR_GROUP, 180, 70, 112, 95
    LTEXT "Foreground:", -1, 190, 88, 58, 12
    CONTROL "Foreground colour", IDC_THEME_PICK_FORE, "Button", BS_OWNERDRAW | WS_TABSTOP, 258, 88, 16, 12
    AUTOCHECKBOX "Use default", IDC_THEME_INHERIT_FORE, 190, 109, 90, 12
    LTEXT "Background:", -1, 190, 126, 58, 12
    CONTROL "Background colour", IDC_THEME_PICK_BACK, "Button", BS_OWNERDRAW | WS_TABSTOP, 258, 126, 16, 12
    AUTOCHECKBOX "Use default", IDC_THEME_INHERIT_BACK, 190, 147, 90, 12
    GROUPBOX "Font style", IDC_THEME_FONT_GROUP, 300, 70, 178, 95
    LTEXT "Font name:", -1, 310, 85, 65, 12
    COMBOBOX IDC_THEME_FONT_NAME, 310, 99, 158, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Bold", IDC_THEME_BOLD, 310, 119, 70, 12
    AUTOCHECKBOX "Italic", IDC_THEME_ITALIC, 310, 134, 70, 12
    AUTOCHECKBOX "Underline", IDC_THEME_UNDERLINE, 310, 149, 70, 12
    LTEXT "Size:", -1, 386, 129, 28, 12
    COMBOBOX IDC_THEME_FONT_SIZE, 418, 125, 50, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Preview", -1, 180, 173, 298, 45
    CONTROL "AaBbYyZz  0123456789", IDC_THEME_SAMPLE, "Static", SS_OWNERDRAW, 190, 187, 278, 22
    AUTOCHECKBOX "Apply to all documents and new documents", IDC_THEME_ALL, 180, 225, 298, 12
    LTEXT "", IDC_THEME_STATUS, 12, 243, 476, 9, SS_LEFTNOWORDWRAP
    GROUPBOX "Keywords", IDC_THEME_KEYWORD_GROUP, 10, 252, 310, 134, NOT WS_VISIBLE
    LTEXT "Keyword set:", IDC_THEME_KEYWORD_LABEL, 20, 267, 55, 12, NOT WS_VISIBLE
    COMBOBOX IDC_THEME_KEYWORD_SLOT, 80, 263, 65, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    COMBOBOX IDC_THEME_KEYWORD_MODE, 153, 263, 157, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "Default keywords:", IDC_THEME_KEYWORD_DEFAULT_LABEL, 20, 291, 140, 12, NOT WS_VISIBLE
    LTEXT "User keywords:", IDC_THEME_KEYWORD_USER_LABEL, 169, 291, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_KEYWORD_DEFAULT, 20, 305, 141, 71, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | NOT WS_VISIBLE
    EDITTEXT IDC_THEME_KEYWORDS, 169, 305, 141, 71, ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    GROUPBOX "File extensions", IDC_THEME_EXT_GROUP, 330, 252, 160, 100, NOT WS_VISIBLE
    LTEXT "Default extensions:", IDC_THEME_EXT_DEFAULT_LABEL, 340, 267, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_EXT_DEFAULT, 340, 281, 140, 16, ES_AUTOHSCROLL | ES_READONLY | NOT WS_VISIBLE
    LTEXT "Additional (separated by ;):", IDC_THEME_EXT_USER_LABEL, 340, 307, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_EXTENSIONS, 340, 321, 140, 16, ES_AUTOHSCROLL | NOT WS_VISIBLE
    PUSHBUTTON "Import report...", IDC_THEME_REPORT_BUTTON, 330, 369, 160, 12, NOT WS_VISIBLE
    PUSHBUTTON "Advanced >>", IDC_THEME_ADVANCED, 10, 255, 92, 12
    PUSHBUTTON "Use defaults", IDC_THEME_STYLE_RESET, 180, 255, 83, 12
    DEFPUSHBUTTON "Save && Close", IDOK, 316, 255, 88, 12
    PUSHBUTTON "Cancel", IDCANCEL, 412, 255, 78, 12
    EDITTEXT IDC_THEME_FOREGROUND, 0, 0, 0, 0, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_BACKGROUND, 0, 0, 0, 0, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_REPORT, 0, 0, 0, 0, ES_MULTILINE | NOT WS_VISIBLE
END
IDD_THEME_REPORT DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Theme import report"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_THEME_REPORT, 10, 10, 410, 202, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 345, 225, 75, 12
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
IDD_THEME_CONFIG DIALOGEX 0, 0, 500, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "语言样式配置器"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "选择主题：", -1, 14, 14, 58, 12
    COMBOBOX IDC_THEME_LIST, 76, 10, 262, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "导入...", IDC_THEME_IMPORT, 346, 10, 66, 12
    PUSHBUTTON "主题...", IDC_THEME_ACTIONS, 420, 10, 66, 12
    GROUPBOX "", -1, 10, 34, 150, 204
    LTEXT "语言：", -1, 20, 46, 130, 12
    COMBOBOX IDC_THEME_LANGUAGE, 20, 60, 130, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "样式：", -1, 20, 85, 130, 12
    LISTBOX IDC_THEME_STYLES, 20, 99, 130, 116, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "显示详细样式", IDC_THEME_DETAILS, 20, 224, 130, 12
    GROUPBOX "", -1, 170, 34, 320, 204
    LTEXT "", IDC_THEME_STYLE_INFO, 182, 46, 296, 18
    GROUPBOX "色彩样式", IDC_THEME_COLOUR_GROUP, 180, 70, 112, 95
    LTEXT "前景色：", -1, 190, 88, 58, 12
    CONTROL "选择前景色", IDC_THEME_PICK_FORE, "Button", BS_OWNERDRAW | WS_TABSTOP, 258, 88, 16, 12
    AUTOCHECKBOX "使用默认值", IDC_THEME_INHERIT_FORE, 190, 109, 90, 12
    LTEXT "背景色：", -1, 190, 126, 58, 12
    CONTROL "选择背景色", IDC_THEME_PICK_BACK, "Button", BS_OWNERDRAW | WS_TABSTOP, 258, 126, 16, 12
    AUTOCHECKBOX "使用默认值", IDC_THEME_INHERIT_BACK, 190, 147, 90, 12
    GROUPBOX "字体样式", IDC_THEME_FONT_GROUP, 300, 70, 178, 95
    LTEXT "字体名称：", -1, 310, 85, 65, 12
    COMBOBOX IDC_THEME_FONT_NAME, 310, 99, 158, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "粗体", IDC_THEME_BOLD, 310, 119, 70, 12
    AUTOCHECKBOX "斜体", IDC_THEME_ITALIC, 310, 134, 70, 12
    AUTOCHECKBOX "下划线", IDC_THEME_UNDERLINE, 310, 149, 70, 12
    LTEXT "字号：", -1, 386, 129, 28, 12
    COMBOBOX IDC_THEME_FONT_SIZE, 418, 125, 50, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "预览", -1, 180, 173, 298, 45
    CONTROL "AaBbYyZz  0123456789", IDC_THEME_SAMPLE, "Static", SS_OWNERDRAW, 190, 187, 278, 22
    AUTOCHECKBOX "应用到所有文档及新建文档", IDC_THEME_ALL, 180, 225, 298, 12
    LTEXT "", IDC_THEME_STATUS, 12, 243, 476, 9, SS_LEFTNOWORDWRAP
    GROUPBOX "关键词", IDC_THEME_KEYWORD_GROUP, 10, 252, 310, 134, NOT WS_VISIBLE
    LTEXT "关键词组：", IDC_THEME_KEYWORD_LABEL, 20, 267, 55, 12, NOT WS_VISIBLE
    COMBOBOX IDC_THEME_KEYWORD_SLOT, 80, 263, 65, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    COMBOBOX IDC_THEME_KEYWORD_MODE, 153, 263, 157, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "默认关键词：", IDC_THEME_KEYWORD_DEFAULT_LABEL, 20, 291, 140, 12, NOT WS_VISIBLE
    LTEXT "用户关键词：", IDC_THEME_KEYWORD_USER_LABEL, 169, 291, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_KEYWORD_DEFAULT, 20, 305, 141, 71, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | NOT WS_VISIBLE
    EDITTEXT IDC_THEME_KEYWORDS, 169, 305, 141, 71, ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    GROUPBOX "文件扩展名", IDC_THEME_EXT_GROUP, 330, 252, 160, 100, NOT WS_VISIBLE
    LTEXT "默认扩展名：", IDC_THEME_EXT_DEFAULT_LABEL, 340, 267, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_EXT_DEFAULT, 340, 281, 140, 16, ES_AUTOHSCROLL | ES_READONLY | NOT WS_VISIBLE
    LTEXT "附加扩展名（分号分隔）：", IDC_THEME_EXT_USER_LABEL, 340, 307, 140, 12, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_EXTENSIONS, 340, 321, 140, 16, ES_AUTOHSCROLL | NOT WS_VISIBLE
    PUSHBUTTON "主题导入报告...", IDC_THEME_REPORT_BUTTON, 330, 369, 160, 12, NOT WS_VISIBLE
    PUSHBUTTON "更多设置 >>", IDC_THEME_ADVANCED, 10, 255, 92, 12
    PUSHBUTTON "恢复默认样式", IDC_THEME_STYLE_RESET, 180, 255, 83, 12
    DEFPUSHBUTTON "保存并关闭", IDOK, 316, 255, 88, 12
    PUSHBUTTON "取消", IDCANCEL, 412, 255, 78, 12
    EDITTEXT IDC_THEME_FOREGROUND, 0, 0, 0, 0, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_BACKGROUND, 0, 0, 0, 0, NOT WS_VISIBLE
    EDITTEXT IDC_THEME_REPORT, 0, 0, 0, 0, ES_MULTILINE | NOT WS_VISIBLE
END
IDD_THEME_REPORT DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "主题导入报告"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_THEME_REPORT, 10, 10, 410, 202, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "关闭", IDOK, 345, 225, 75, 12
END
