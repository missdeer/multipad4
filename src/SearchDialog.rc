#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "SearchResources.h"
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_SEARCH DIALOGEX 0, 0, 411, 197
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Find"
FONT 8, "MS Shell Dlg"
BEGIN
 CONTROL "", IDC_SEARCH_TABS, "SysTabControl32", WS_TABSTOP, 2, 2, 407, 15
 RTEXT "&Find what:", IDC_SEARCH_FIND_LABEL, 1, 28, 73, 8
 COMBOBOX IDC_FINDTEXT, 76, 26, 170, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 RTEXT "Rep&lace with:", IDC_SEARCH_REPLACE_LABEL, 1, 46, 73, 8
 COMBOBOX IDC_REPLACETEXT, 76, 44, 170, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 CONTROL "↕", IDC_SEARCH_SWAP, "Button", BS_SPLITBUTTON | WS_TABSTOP, 250, 35, 24, 16
 RTEXT "Filter&s:", IDC_SEARCH_FILTER_LABEL, 1, 64, 73, 8
 COMBOBOX IDC_SEARCH_FILTER, 76, 62, 170, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 LTEXT "(?)", IDC_SEARCH_FILTER_HELP, 252, 64, 14, 8, SS_NOTIFY | WS_TABSTOP
 RTEXT "&Directory:", IDC_SEARCH_DIRECTORY_LABEL, 7, 82, 41, 8
 COMBOBOX IDC_SEARCH_DIRECTORY, 50, 80, 196, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "...", IDC_SEARCH_BROWSE, 250, 80, 16, 14
 PUSHBUTTON "<<", IDC_SEARCH_CURRENT_DIRECTORY, 270, 80, 16, 14
 CONTROL "In all sub-folders", IDC_SEARCH_RECURSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 98, 110, 10
 CONTROL "In hidden folders", IDC_SEARCH_HIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 110, 110, 10
 CONTROL "Backward direction", IDC_SEARCH_BACKWARDS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 86, 155, 10
 CONTROL "Match &whole word only", IDC_FINDWORD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 98, 155, 10
 CONTROL "Match &case", IDC_FINDCASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 110, 155, 10
 CONTROL "Wra&p around", IDC_SEARCH_WRAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 122, 155, 10
 CONTROL "In select&ion", IDC_SEARCH_SELECTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 64, 100, 10
 CONTROL "Book&mark line", IDC_FINDALLBOOKMARK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 62, 155, 10
 CONTROL "Purge for each search", IDC_SEARCH_PURGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 74, 155, 10
 GROUPBOX "Search Mode", IDC_SEARCH_MODE_GROUP, 6, 140, 200, 48
 CONTROL "&Normal", IDC_SEARCH_NORMAL, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 152, 180, 10
 CONTROL "E&xtended (\\n, \\r, \\t, \\0, \\x...)", IDC_SEARCH_EXTENDED, "Button", BS_AUTORADIOBUTTON, 12, 164, 180, 10
 CONTROL "Re&gular expression", IDC_SEARCH_REGEX, "Button", BS_AUTORADIOBUTTON, 12, 176, 85, 10
 CONTROL "&. matches newline", IDC_FIND_DOTALL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 176, 103, 10
 CONTROL "Transparenc&y", IDC_SEARCH_TRANSPARENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 284, 140, 100, 10
 GROUPBOX "", IDC_SEARCH_TRANSPARENT_GROUP, 288, 140, 101, 48, WS_CLIPSIBLINGS
 CONTROL "On losing focus", IDC_SEARCH_TRANSPARENT_LOST, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 298, 152, 88, 10
 CONTROL "Always", IDC_SEARCH_TRANSPARENT_ALWAYS, "Button", BS_AUTORADIOBUTTON, 298, 164, 88, 10
 CONTROL "", IDC_SEARCH_OPACITY, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 294, 176, 88, 10
 DEFPUSHBUTTON "Find Next", IDOK, 298, 26, 91, 14
 PUSHBUTTON "Find Previous", IDC_FINDPREV, 298, 44, 91, 14
 PUSHBUTTON "Coun&t", IDC_SEARCH_COUNT, 298, 62, 91, 14
 PUSHBUTTON "Find All in Current Document", IDC_FINDALL, 298, 80, 91, 21, BS_MULTILINE
 PUSHBUTTON "Find All in All Opened Documents", IDC_SEARCH_ALL_OPEN, 298, 105, 91, 21, BS_MULTILINE
 PUSHBUTTON "&Replace", IDC_REPLACE, 298, 44, 91, 14
 PUSHBUTTON "Replace &All", IDC_REPLACEALL, 298, 62, 91, 14
 PUSHBUTTON "Replace All in All Opened Documents", IDC_SEARCH_REPLACE_OPEN, 298, 80, 91, 21, BS_MULTILINE
 PUSHBUTTON "Find All", IDC_SEARCH_FILES, 298, 26, 91, 14
 PUSHBUTTON "Replace in Files", IDC_SEARCH_REPLACE_FILES, 298, 44, 91, 14
 PUSHBUTTON "Mark All", IDC_SEARCH_MARK, 298, 44, 91, 14
 PUSHBUTTON "Clear all marks", IDC_SEARCH_CLEAR_MARK, 298, 62, 91, 14
 PUSHBUTTON "Close", IDCANCEL, 298, 128, 91, 14
 LTEXT "", IDC_SEARCH_STATUS, 8, 189, 380, 8, SS_LEFTNOWORDWRAP
 PUSHBUTTON "⌃", IDC_SEARCH_EXPAND, 393, 182, 16, 14
END
