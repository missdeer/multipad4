#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include <atlres.h>
#include "resource.h"
#ifdef __MINGW32__
// MSVC embeds this through its linker; windres needs an explicit resource.
1 RT_MANIFEST "MultiPad4.manifest"
#endif
// The complete upstream menu, accelerator table, dialogs and images are compiled
// separately by cmake/Notepad4Resources.cmake. Only MDI additions belong here.
IDR_MDIACCEL ACCELERATORS
BEGIN
 "F", ID_FIND, VIRTKEY, CONTROL
 "H", IDM_EDIT_REPLACE, VIRTKEY, CONTROL
 "S", ID_SAVEALL, VIRTKEY, CONTROL, ALT
 "W", ID_CLOSE, VIRTKEY, CONTROL
 VK_F4, ID_CLOSE, VIRTKEY, CONTROL
 "F", ID_SEARCH_FILES, VIRTKEY, CONTROL, SHIFT
 VK_F7, ID_SEARCH_RESULTS, VIRTKEY
 "M", ID_SEARCH_MARK, VIRTKEY, CONTROL
 VK_TAB, ID_NEXTTAB, VIRTKEY, CONTROL
 VK_TAB, ID_PREVTAB, VIRTKEY, CONTROL, SHIFT
END
STRINGTABLE
BEGIN
 IDR_MAINFRAME "MultiPad4\nMultiPad4\nMultiPad4\n\n\nMultiPad4.Document\nMultiPad4 Document"
END

#include "../3rdparty/notepad-plus-plus/PluginsAdmin/pluginsAdmin.rc"
5515 RCDATA "../3rdparty/notepad-plus-plus/PluginsAdmin/pl.x64.json"

5520 RCDATA "../config/languages/default.xml"
5521 RCDATA "../config/themes/light.xml"
5522 RCDATA "../config/themes/dark.xml"

IDD_FILE_ASSOCIATIONS DIALOGEX 0, 0, 408, 284
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "File Associations"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Filter:", IDC_ASSOCIATION_FILTER_LABEL, 10, 14, 40, 10
    EDITTEXT IDC_ASSOCIATION_FILTER, 51, 10, 141, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Select all", IDC_ASSOCIATION_SELECT, 202, 10, 62, 16
    PUSHBUTTON "Select none", IDC_ASSOCIATION_CLEAR, 269, 10, 62, 16
    PUSHBUTTON "Invert selection", IDC_ASSOCIATION_INVERT, 336, 10, 62, 16
    CONTROL "", IDC_ASSOCIATION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_BORDER, 10, 32, 388, 179
    LTEXT "", IDC_ASSOCIATION_STATUS, 10, 216, 388, 12
    LTEXT "To make MultiPad4 open a file type by default, choose it for that extension in Windows Settings.", IDC_ASSOCIATION_DEFAULTS_HELP, 10, 231, 388, 24
    DEFPUSHBUTTON "Save registration", IDOK, 96, 259, 86, 16
    PUSHBUTTON "Save and open Default Apps...", IDC_ASSOCIATION_DEFAULTS, 187, 259, 148, 16
    PUSHBUTTON "Close", IDCANCEL, 340, 259, 58, 16
END

IDD_TAB_SETTINGS DIALOGEX 0, 0, 314, 153
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Document Tab Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Tab title font:", IDC_TAB_FONT_LABEL, 10, 10, 294, 10
    PUSHBUTTON "中文 かな 한글 &Font…", IDC_TAB_FONT_PREVIEW, 10, 24, 294, 42
    PUSHBUTTON "Use &system font", IDC_TAB_FONT_RESET, 10, 71, 98, 14
    AUTOCHECKBOX "Fi&xed tab width", IDC_TAB_FIXED_WIDTH, 10, 95, 110, 12
    LTEXT "&Width (logical pixels):", IDC_TAB_WIDTH_LABEL, 10, 113, 108, 10
    EDITTEXT IDC_TAB_WIDTH_PIXELS, 197, 110, 107, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_TAB_WIDTH_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 292, 110, 12, 15
    DEFPUSHBUTTON "OK", IDOK, 202, 130, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 254, 130, 50, 14
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDR_TAB_POPUP MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Close Tab", ID_CLOSE
        MENUITEM "Close Tabs to the &Left", ID_CLOSE_LEFT_TABS
        MENUITEM "Close Tabs to the &Right", ID_CLOSE_RIGHT_TABS
        MENUITEM "Close &Other Tabs", ID_CLOSE_OTHER_TABS
        MENUITEM "Close &All Tabs", ID_CLOSEALL
    END
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
IDR_TAB_POPUP MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "关闭当前标签(&C)", ID_CLOSE
        MENUITEM "关闭左侧标签(&L)", ID_CLOSE_LEFT_TABS
        MENUITEM "关闭右侧标签(&R)", ID_CLOSE_RIGHT_TABS
        MENUITEM "关闭其他标签(&O)", ID_CLOSE_OTHER_TABS
        MENUITEM "关闭全部标签(&A)", ID_CLOSEALL
    END
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL
IDR_TAB_POPUP MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "關閉目前分頁(&C)", ID_CLOSE
        MENUITEM "關閉左側分頁(&L)", ID_CLOSE_LEFT_TABS
        MENUITEM "關閉右側分頁(&R)", ID_CLOSE_RIGHT_TABS
        MENUITEM "關閉其他分頁(&O)", ID_CLOSE_OTHER_TABS
        MENUITEM "關閉所有分頁(&A)", ID_CLOSEALL
    END
END
