#pragma code_page(65001)
#include <windows.h>
#include <atlres.h>
#include "resource.h"
#ifdef __MINGW32__
// MSVC embeds this through its linker; windres needs an explicit resource.
1 RT_MANIFEST "MultiPad4.manifest"
#endif
// The complete upstream menu, accelerator table, dialogs and images are compiled
// separately by cmake/Notepad4Resources.cmake. Only MDI additions belong here.
IDR_MDIACCEL ACCELERATORS
BEGIN
 "F", ID_FIND, VIRTKEY, CONTROL
 "H", IDM_EDIT_REPLACE, VIRTKEY, CONTROL
 "S", ID_SAVEALL, VIRTKEY, CONTROL, ALT
 "W", ID_CLOSE, VIRTKEY, CONTROL
 VK_F4, ID_CLOSE, VIRTKEY, CONTROL
 "F", ID_SEARCH_FILES, VIRTKEY, CONTROL, SHIFT
 VK_F7, ID_SEARCH_RESULTS, VIRTKEY
 "M", ID_SEARCH_MARK, VIRTKEY, CONTROL
 VK_TAB, ID_NEXTTAB, VIRTKEY, CONTROL
 VK_TAB, ID_PREVTAB, VIRTKEY, CONTROL, SHIFT
END
STRINGTABLE
BEGIN
 IDR_MAINFRAME "MultiPad4\nMultiPad4\nMultiPad4\n\n\nMultiPad4.Document\nMultiPad4 Document"
END

