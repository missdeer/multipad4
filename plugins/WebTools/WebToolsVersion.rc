#include <windows.h>

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "PluginName", "Web Tools"
            VALUE "FileDescription", "MultiPad4 Web Tools"
            VALUE "Comments", "Code formatting, JavaScript evaluation, and HTML/XML and URL conversions."
            VALUE "Author", "MultiPad4 contributors"
            VALUE "FileVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
