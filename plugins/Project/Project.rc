#include <windows.h>
#include "Resources.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

PROJECT_MANAGER DIALOGEX 0, 0, 400, 226
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Projects"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Projects", -1, 8, 8, 112, 10
    LISTBOX PROJECT_LIST, 8, 21, 118, 109, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_TABSTOP | WS_VSCROLL | WS_HSCROLL
    LTEXT "&Files and folders", -1, 134, 8, 256, 10
    LISTBOX PROJECT_MEMBERS, 134, 21, 258, 109, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_TABSTOP | WS_VSCROLL | WS_HSCROLL

    PUSHBUTTON "&New...", PROJECT_NEW, 8, 134, 38, 14
    PUSHBUTTON "Re&name...", PROJECT_RENAME, 48, 134, 39, 14
    PUSHBUTTON "&Delete", PROJECT_REMOVE, 89, 134, 37, 14
    PUSHBUTTON "Move Up", PROJECT_UP, 8, 152, 58, 14
    PUSHBUTTON "Move Down", PROJECT_DOWN, 68, 152, 58, 14
    PUSHBUTTON "Add Fi&les...", PROJECT_ADD_FILES, 134, 134, 60, 14
    PUSHBUTTON "Add F&older...", PROJECT_ADD_FOLDER, 198, 134, 60, 14
    PUSHBUTTON "&Remove", PROJECT_REMOVE_MEMBER, 262, 134, 60, 14
    PUSHBUTTON "Move Up", PROJECT_MEMBER_UP, 134, 152, 60, 14
    PUSHBUTTON "Move Down", PROJECT_MEMBER_DOWN, 198, 152, 60, 14
    PUSHBUTTON "&Sort by Name", PROJECT_SORT, 262, 152, 60, 14

    LTEXT "&Base folder", -1, 8, 176, 47, 10
    EDITTEXT PROJECT_BASE, 57, 173, 226, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Bro&wse...", PROJECT_SET_BASE, 287, 173, 50, 14
    PUSHBUTTON "C&lear", PROJECT_CLEAR_BASE, 342, 173, 50, 14
    CONTROL "L&oad files on project selection", PROJECT_AUTO_LOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 193, 190, 12
    DEFPUSHBUTTON "OK", IDOK, 286, 204, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 342, 204, 50, 14
END

PROJECT_PICK DIALOGEX 0, 0, 322, 164
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", PROJECT_LABEL, 8, 8, 306, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    LISTBOX PROJECT_LIST, 8, 21, 306, 116, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 208, 142, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 264, 142, 50, 14
END

PROJECT_TEXT DIALOGEX 0, 0, 252, 67
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", PROJECT_LABEL, 8, 8, 236, 10
    EDITTEXT PROJECT_INPUT, 8, 21, 236, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 138, 45, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 194, 45, 50, 14
END

PROJECT_PANE DIALOGEX 0, 0, 180, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Project", -1, 6, 6, 90, 10
    COMBOBOX PROJECT_PANE_SELECTOR, 6, 18, 168, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Files and folders", -1, 6, 38, 90, 10
    LISTBOX PROJECT_PANE_FILES, 6, 50, 168, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT "No project members", PROJECT_PANE_STATUS, 11, 55, 150, 24, SS_NOPREFIX
    PUSHBUTTON "&Open", PROJECT_PANE_OPEN, 6, 180, 50, 14
    PUSHBUTTON "&Edit Projects...", PROJECT_PANE_EDIT, 62, 180, 70, 14
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "PluginName", "Project"
            VALUE "FileDescription", "MultiPad4 Project"
            VALUE "Comments", "Organize and reopen groups of files and folders."
            VALUE "Author", "MultiPad4 contributors"
            VALUE "FileVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
