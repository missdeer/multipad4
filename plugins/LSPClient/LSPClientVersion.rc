#include <windows.h>

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "PluginName", "LSP Client"
            VALUE "FileDescription", "MultiPad4 LSP Client"
            VALUE "Comments", "Language-server completion, signature help, hover, definitions and diagnostics."
            VALUE "Author", "MultiPad4 contributors"
            VALUE "FileVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

100 DIALOGEX 0, 0, 230, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search and Go to Symbol"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Symbol name", -1, 7, 5, 212, 10
    EDITTEXT 101, 7, 17, 216, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Search", IDOK, 115, 40, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 171, 40, 52, 14
END
