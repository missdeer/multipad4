set(SELECTION_ACTIONS_MENU_STRINGS "#include <windows.h>\n#include \"resource.h\"\n#pragma code_page(65001)\n")

function(multipad4_extract_selection_actions variable locale language)
  set(content "${${variable}}")
  string(REGEX MATCH "\n\t\tMENUITEM SEPARATOR\n\t\tPOPUP \"([^\n]*)\"\n\t\tBEGIN\n\t\t\tMENUITEM [^\n]*CMD_OPEN_PATH_OR_LINK[^\n]*\n(\t\t\tMENUITEM[^\n]*\n)+\t\tEND" selection_menu "${content}")
  set(selection_title "${CMAKE_MATCH_1}")
  string(REGEX MATCH "\n\t\tMENUITEM SEPARATOR\n\t\tMENUITEM \"([^\n]*)\",?[ \t]*CMD_OPEN_PATH_OR_LINK" context_item "${content}")
  set(context_label "${CMAKE_MATCH_1}")
  if(NOT selection_menu OR NOT context_item)
    message(FATAL_ERROR "Cannot locate the Action on Selection menus for ${locale}")
  endif()
  string(APPEND SELECTION_ACTIONS_MENU_STRINGS "${language}\nSTRINGTABLE\nBEGIN\n    1 \"${selection_title}\"\n    2 \"${context_label}\"\n")
  foreach(command CMD_OPEN_PATH_OR_LINK CMD_OPEN_CONTAINING_FOLDER CMD_CALCULATE_EXPR
      CMD_ONLINE_SEARCH_GOOGLE CMD_ONLINE_SEARCH_BING CMD_ONLINE_SEARCH_WIKI CMD_CUSTOM_ACTION1 CMD_CUSTOM_ACTION2)
    string(REGEX MATCH "MENUITEM \"([^\n]*)\",?[ \t]*${command}[\r\n]" item "${selection_menu}")
    if(NOT item)
      message(FATAL_ERROR "Cannot locate the Action on Selection command ${command} for ${locale}")
    endif()
    string(APPEND SELECTION_ACTIONS_MENU_STRINGS "    ${command} \"${CMAKE_MATCH_1}\"\n")
  endforeach()
  string(APPEND SELECTION_ACTIONS_MENU_STRINGS "END\n")
  string(REPLACE "${selection_menu}" "" content "${content}")
  string(REPLACE "${context_item}" "" content "${content}")
  string(REGEX REPLACE "\n[ \t]+\"[^\n]+\",[ \t]+CMD_CUSTOM_ACTION[12],[^\n]*" "" content "${content}")
  if(content MATCHES "MENUITEM[^\n]*CMD_(OPEN_PATH_OR_LINK|OPEN_CONTAINING_FOLDER|CALCULATE_EXPR|ONLINE_SEARCH_|CUSTOM_ACTION)")
    message(FATAL_ERROR "Cannot remove the Action on Selection menu items for ${locale}")
  endif()
  set(${variable} "${content}" PARENT_SCOPE)
  set(SELECTION_ACTIONS_MENU_STRINGS "${SELECTION_ACTIONS_MENU_STRINGS}" PARENT_SCOPE)
endfunction()
