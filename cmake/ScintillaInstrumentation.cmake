# Keep upstream pristine. Only build copies expose optional UI-thread metrics.
set(SCI_INSTRUMENTED_DIR "${PROJECT_BINARY_DIR}/framework-compat/ScintillaCore")
file(GLOB SCI_CORE_FILES CONFIGURE_DEPENDS "${SCI_ROOT}/src/*.h" "${SCI_ROOT}/src/*.cxx")
foreach(source IN LISTS SCI_CORE_FILES)
  get_filename_component(name "${source}" NAME)
  if(name STREQUAL "Document.cxx" OR name STREQUAL "Document.h")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    string(PREPEND text "#include \"LexerMetrics.h\"\n")
    if(name STREQUAL "Document.cxx")
      string(REPLACE "instance->Lex(start, len, styleStart, pdoc);"
        "lexerMetrics::Scope metrics(start, len);\n\t\t\tinstance->Lex(start, len, styleStart, pdoc);\n\t\t\tmetrics.Fold();" text "${text}")
      string(REPLACE "instance->Fold(start, len, styleStart, pdoc);" "instance->Fold(start, len, styleStart, pdoc);\n\t\t\tmetrics.EndFold();" text "${text}")
      string(REPLACE "endStyled = position;" "lexerMetrics::StartStyling(position);\n\tendStyled = position;" text "${text}")
      string(REPLACE "enteredStyling++;" "lexerMetrics::Submit(length);\n\tenteredStyling++;" text "${text}")
    else()
      string(REPLACE "cb.GetCharRange(buffer, position, lengthRetrieve);"
        "lexerMetrics::Fetch(position, lengthRetrieve);\n\t\tcb.GetCharRange(buffer, position, lengthRetrieve);" text "${text}")
    endif()
    file(CONFIGURE OUTPUT "${SCI_INSTRUMENTED_DIR}/${name}" CONTENT "${text}" @ONLY)
  else()
    configure_file("${source}" "${SCI_INSTRUMENTED_DIR}/${name}" COPYONLY)
  endif()
  if(name MATCHES "\\.cxx$")
    list(REMOVE_ITEM SCI_SOURCES "${source}")
    list(APPEND SCI_SOURCES "${SCI_INSTRUMENTED_DIR}/${name}")
  endif()
endforeach()

# Character-read tracing is opt-in: its per-character branch is excluded from
# ordinary binaries. Timing/call/style-submission counters stay lightweight.
set(SCI_LEXLIB_DIR "${PROJECT_BINARY_DIR}/framework-compat/Lexlib")
file(GLOB SCI_LEXLIB_FILES CONFIGURE_DEPENDS "${SCI_ROOT}/lexlib/*.h" "${SCI_ROOT}/lexlib/*.cxx")
foreach(source IN LISTS SCI_LEXLIB_FILES)
  get_filename_component(name "${source}" NAME)
  if(name STREQUAL "LexAccessor.h" OR name STREQUAL "LexAccessor.cxx")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    string(PREPEND text "#include \"LexerMetrics.h\"\n")
    string(REPLACE "return cbView[position];" "lexerMetrics::Fetch(position, 1);\n\t\treturn cbView[position];" text "${text}")
    string(REPLACE "return cbView.CharAt(position);" "lexerMetrics::Fetch(position, 1);\n\t\treturn cbView.CharAt(position);" text "${text}")
    string(REPLACE "len = endPos_ - startPos_;" "len = endPos_ - startPos_;\n\tlexerMetrics::Fetch(startPos_, len);" text "${text}")
    file(CONFIGURE OUTPUT "${SCI_LEXLIB_DIR}/${name}" CONTENT "${text}" @ONLY)
  else()
    configure_file("${source}" "${SCI_LEXLIB_DIR}/${name}" COPYONLY)
  endif()
  if(name MATCHES "\\.cxx$")
    list(REMOVE_ITEM SCI_SOURCES "${source}")
    list(APPEND SCI_SOURCES "${SCI_LEXLIB_DIR}/${name}")
  endif()
endforeach()
