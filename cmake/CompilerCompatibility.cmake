set(MULTIPAD4_WTL_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/wtl/Include")
if(MSVC)
  if(CMAKE_RC_COMPILER MATCHES "llvm-rc")
    # Set UTF-8 explicitly for llvm-rc. CMake's argument filter recognizes
    # uppercase /C and keeps this resource-only option out of preprocessing.
    string(APPEND CMAKE_RC_FLAGS " /C65001")
  endif()
  set(MULTIPAD4_WARNINGS /W4 /EHsc)
  set(MULTIPAD4_VENDOR_WARNINGS /W3 /EHsc)
else()
  add_compile_options("$<$<COMPILE_LANGUAGE:RC>:--use-temp-file>")
  set(MULTIPAD4_WARNINGS -Wall -Wextra -Wno-unused-parameter)
  set(MULTIPAD4_VENDOR_WARNINGS -Wno-unknown-pragmas)
  set(OPENATL_COMPAT_DIR "${PROJECT_BINARY_DIR}/framework-compat/OpenATL")
  file(GLOB openatl_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/3rdparty/OpenATL/include/*.h")
  foreach(header IN LISTS openatl_headers)
    get_filename_component(name "${header}" NAME)
    configure_file("${header}" "${OPENATL_COMPAT_DIR}/${name}" COPYONLY)
  endforeach()
  set(MULTIPAD4_WTL_INCLUDE_DIR "${PROJECT_BINARY_DIR}/framework-compat/WTL")
  file(GLOB wtl_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/3rdparty/wtl/Include/*.h")
  foreach(header IN LISTS wtl_headers)
    get_filename_component(name "${header}" NAME)
    configure_file("${header}" "${MULTIPAD4_WTL_INCLUDE_DIR}/${name}" COPYONLY)
  endforeach()
endif()
