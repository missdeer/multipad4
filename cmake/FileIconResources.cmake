set(icon_directory "${PROJECT_SOURCE_DIR}/res/icons")
set(icon_ids "${icon_directory}/resource-ids.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${icon_ids}")
file(STRINGS "${icon_ids}" icon_entries)
file(GLOB icon_sources CONFIGURE_DEPENDS "${icon_directory}/file-*.ico")

set(icon_resources "")
set(icon_lookup "")
set(used_ids "")
foreach(entry IN LISTS icon_entries)
  if(NOT entry MATCHES "^([1-9][0-9]*) ([a-z0-9][a-z0-9_-]*)$")
    message(FATAL_ERROR "Invalid file icon resource entry: ${entry}")
  endif()
  set(id "${CMAKE_MATCH_1}")
  set(extension "${CMAKE_MATCH_2}")
  set(icon "${icon_directory}/file-${extension}.ico")
  if(id LESS 46000 OR id GREATER 49999 OR id IN_LIST used_ids OR NOT icon IN_LIST icon_sources)
    message(FATAL_ERROR "Duplicate, out-of-range or missing file icon resource: ${entry}")
  endif()
  list(APPEND used_ids "${id}")
  list(REMOVE_ITEM icon_sources "${icon}")
  list(APPEND icon_dependencies "${icon}")
  string(APPEND icon_resources "${id} ICON \"${icon}\"\n")
  string(APPEND icon_lookup "    {L\".${extension}\", ${id}},\n")
endforeach()
if(icon_sources)
  message(FATAL_ERROR "File icons without permanent resource IDs: ${icon_sources}")
endif()

set(default_file_icon "${PROJECT_SOURCE_DIR}/3rdparty/notepad4/res/Notepad4.ico")
string(APPEND icon_resources "IDI_DEFAULT_FILE ICON \"${default_file_icon}\"\n")

file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/FileIconResources.rcinc" CONTENT "@icon_resources@" @ONLY)
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/FileIconResources.inc" CONTENT "@icon_lookup@" @ONLY)
set_property(SOURCE src/FileAssociations.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${PROJECT_BINARY_DIR}")
set_property(SOURCE "${PROJECT_BINARY_DIR}/Notepad4Resources.rc" APPEND PROPERTY OBJECT_DEPENDS
  "${PROJECT_BINARY_DIR}/FileIconResources.rcinc" "${default_file_icon}" ${icon_dependencies})
